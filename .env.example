# Copie para .env — que está no .gitignore. Nenhum valor real entra no repositório
# (Invariante 3). Este arquivo é forma, não conteúdo.

# --- RUCard (bandejão) -------------------------------------------------------
# Chave embutida no app oficial, compartilhada, não é credencial pessoal.
# Já está no §1.2 do SPEC1.md; fica aqui só para o código não hardcodar.
RUCARD_HASH=596df9effde6f877717b4e81fdb2ca9f

# --- Moodle / e-Disciplinas --------------------------------------------------
# CREDENCIAL PESSOAL. Invariante 4: não sai da máquina do dono, não vai para
# servidor hospedado, nem "só pra testar".
# Como obter: §8 do SPEC1.md (fluxo de launch.php, com o navegador logado).
# O token do Caio expira em 17/11/2026 e é revogável em managetoken.php.
MOODLE_URL=https://edisciplinas.usp.br
MOODLE_TOKEN=

# MOODLE_USERID NÃO se configura aqui — de propósito. Ele sai do próprio token,
# via core_webservice_get_site_info, em uma chamada. Medido em 28/08/2026:
# com o userid ERRADO, core_enrol_get_users_courses devolve [] com HTTP 200 e
# nenhum erro — o falso "não tem nada" que o Invariante 6 proíbe. Com o userid
# AUSENTE, a mesma função dá invalidparameter, que é barulhento e seguro.
# Configurar à mão só cria a chance de errar em silêncio. Derive.

# --- Escrita -----------------------------------------------------------------
# Invariante 1: read-only por padrão. Ligar isto NÃO libera a lista de bloqueio
# permanente do §2.2 (quiz, autologin_key, mensagens) e não libera entrega:
# desde 15/09/2026 as duas de mod_assign têm flag PRÓPRIA, logo abaixo.
USP_MCP_ALLOW_WRITES=0

# Entrega de atividade, com confirmação humana em duas etapas. Flag separada de
# propósito: a de cima está documentada nos três servidores como flag que não
# abre nada, e reaproveitá-la mudaria em silêncio o significado dela em código
# que os testes de cada servidor afirmam.
#
# Ligada, aparecem duas ferramentas no servidor do Moodle: salvar rascunho e
# entregar para correção. Entregar não tem desfazer, nem pela API nem pelo site.
# As três de questionário seguem no bloqueio permanente, e não há flag que as
# libere. Leia a seção "Entregando trabalho" do README antes de ligar.
USP_MCP_ENTREGA=0
